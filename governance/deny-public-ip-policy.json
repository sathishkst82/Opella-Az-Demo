{
  "name": "sathish-deny-public-ip",
  "displayName": "Sathish - Deny Public IP",
  "mode": "All",
  "description": "Denies creation of standalone public IP resources.",
  "policyRule": {
    "if": {
      "field": "type",
      "equals": "Microsoft.Network/publicIPAddresses"
    },
    "then": {
      "effect": "deny"
    }
  }
}
